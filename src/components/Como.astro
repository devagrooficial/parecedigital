---
import Icon from './Icon.astro';
import ComoFluxo from './flow/ComoFluxo.tsx';
import { STEPS } from '../lib/steps';
---

<section id="como" class="px-6 py-16 md:px-10 md:py-24">
	<p class="mb-5 font-mono text-[13px] tracking-[.14em] text-muted uppercase">Como funciona</p>
	<h2 class="mb-12 max-w-[640px] text-[32px] leading-[1.15] md:text-[40px]">Quatro passos, nenhum deles burocrático</h2>

	<!-- Telas largas: diagrama de fluxo. O JS do ReactFlow só é baixado quando este bloco entra na tela. -->
	<div
		class="hidden h-[392px] overflow-hidden rounded-[14px] border border-hairline bg-cream-card/60 frame:block"
		aria-hidden="true"
	>
		<ComoFluxo client:visible={{ rootMargin: '300px' }} />
	</div>

	<!-- Telas menores: a mesma sequência em lista vertical, sem JavaScript. Em telas largas fica só para leitores de tela. -->
	<ol class="grid gap-7 frame:sr-only">
		{
			STEPS.map((s, i) => (
				<li class="relative pl-16">
					<span class="absolute top-0 left-0 grid size-11 place-items-center rounded-[10px] bg-accent text-white">
						<Icon name={s.icone} size={22} />
					</span>
					{i < STEPS.length - 1 && <span class="absolute top-14 -bottom-7 left-[21.5px] border-l border-dashed border-accent/60" aria-hidden="true" />}
					<div class="rounded-[14px] border border-hairline bg-cream-card p-5">
						<p class="mb-2 font-mono text-[13px] text-rust-dark">{s.numero}</p>
						<h3 class="mb-2 text-[22px] leading-tight">{s.titulo}</h3>
						<p class="mb-4 text-base leading-[1.6] text-muted">{s.texto}</p>
						<span class="inline-flex items-center gap-2 rounded-full border border-hairline-strong px-3 py-1 font-mono text-xs text-ink">
							<span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
							{s.meta}
						</span>
					</div>
				</li>
			))
		}
	</ol>
</section>
