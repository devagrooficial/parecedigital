---
import { Image } from 'astro:assets';
import logo from '../assets/logo/logoh1.png';

interface Props {
	width?: number;
}

const { width = 170 } = Astro.props;
const height = Math.round((width * logo.height) / logo.width);
---

<Image src={logo} alt="Parecer Digital" height={height} width={width} />
