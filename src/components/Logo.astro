---
import { Image } from 'astro:assets';
import logo from '../assets/logo/logoh1.png';

interface Props {
	height?: number;
}

const { height = 28 } = Astro.props;
const width = Math.round((height * logo.width) / logo.height);
---

<Image src={logo} alt="Parecer Digital" height={height} width={width} />
