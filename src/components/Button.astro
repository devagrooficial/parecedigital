---
interface Props {
	href: string;
	variant?: 'primary' | 'secondary' | 'accent';
	size?: 'sm' | 'md' | 'lg';
	/** Identifica a seção de origem do clique de WhatsApp (rastreamento). */
	section?: string;
	class?: string;
}

const { href, variant = 'primary', size = 'md', section, class: className } = Astro.props;

const variants = {
	primary: 'border-transparent bg-ink text-white hover:bg-black hover:text-white',
	secondary: 'border-hairline-strong text-ink hover:border-accent hover:bg-[#EFE7DD] hover:text-ink',
	accent: 'border-transparent bg-accent text-white hover:bg-accent-dark hover:text-white',
};
const sizes = {
	sm: 'min-h-11 px-5 text-[15px]',
	md: 'min-h-14 px-[30px] text-[17px]',
	lg: 'min-h-16 px-10 text-2xl',
};
---

<a
	href={href}
	data-wa-section={section}
	class:list={[
		'inline-flex items-center justify-center gap-2.5 rounded-[10px] border font-semibold no-underline transition-colors max-md:w-full',
		variants[variant],
		sizes[size],
		className,
	]}
>
	<slot />
</a>
