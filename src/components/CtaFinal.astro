---
import Button from './Button.astro';
import { WHATSAPP_LINKS } from '../config';
---

<section class="relative overflow-hidden bg-ink px-6 py-16 text-center text-[#F7F3EE] md:px-10 md:py-24">
	<!-- hachura clara nas bordas do bloco, no mesmo desenho das faixas da página -->
	<div
		class="pointer-events-none absolute inset-0"
		style="background-image: repeating-linear-gradient(135deg, rgb(247 243 238 / 0.045) 0, rgb(247 243 238 / 0.045) 1px, transparent 1px, transparent 7px); mask-image: linear-gradient(90deg, #000, transparent 22%, transparent 78%, #000);"
		aria-hidden="true"
	>
	</div>
	<div class="relative">
		<h2 class="mx-auto mb-5 max-w-[700px] text-[32px] leading-[1.12] text-[#F7F3EE] md:text-[44px]">
			Me manda o caso e eu te digo hoje se tem material ali.
		</h2>
		<p class="mx-auto mb-10 max-w-[560px] text-lg leading-[1.6] text-on-dark">
			Primeira conversa sem custo e sem compromisso. Você descreve o processo, eu digo se vale a análise — e se não valer, eu falo isso também.
		</p>
		<Button href={WHATSAPP_LINKS.ctaFinal} section="cta-final" variant="accent" size="lg">Chamar no WhatsApp</Button>
		<p class="mt-6 font-mono text-sm text-on-dark-2">Resposta em até 2 horas em dia útil</p>
	</div>
</section>
