---
// Faixa de números logo abaixo do hero. Todos os valores já existem no texto da página.
const fatos = [
	{ valor: '48 h', legenda: 'do escopo à entrega do parecer em PDF' },
	{ valor: 'R$ 1.800', legenda: 'por caso, preço fechado antes de começar' },
	{ valor: '100 mil', legenda: 'mensagens por caso, em uma ou várias conversas' },
	{ valor: '30 dias', legenda: 'depois da entrega, o material é eliminado' },
];
---

<section aria-label="Resumo do serviço" class="grid grid-cols-2 border-t border-hairline md:grid-cols-4">
	{
		fatos.map((f, i) => (
			<div
				class:list={[
					'px-6 py-7 md:px-8',
					i % 2 === 1 && 'border-l border-hairline',
					i > 1 && 'border-t border-hairline md:border-t-0',
					i > 0 && 'md:border-l md:border-hairline',
				]}
			>
				<p class="font-serif text-[34px] leading-none font-bold text-ink md:text-[40px]">{f.valor}</p>
				<p class="mt-3 max-w-[200px] text-sm leading-snug text-muted">{f.legenda}</p>
			</div>
		))
	}
</section>
