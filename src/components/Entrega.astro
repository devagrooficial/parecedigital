---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

const itens: { icone: IconName; titulo: string; texto: string }[] = [
	{ icone: 'file', titulo: 'Parecer técnico em PDF', texto: 'Paginado, numerado e com metodologia descrita. Formatado para ser juntado ao processo sem retrabalho.' },
	{ icone: 'quote', titulo: 'Os trechos que importam', texto: 'Transcritos com data, hora, autor e a posição exata que cada mensagem ocupa no arquivo original.' },
	{ icone: 'timeline', titulo: 'Linha do tempo dos fatos', texto: 'A cronologia montada do jeito que entra na petição: o que foi dito, por quem e em que ordem.' },
	{ icone: 'hash', titulo: 'Integridade verificável', texto: 'Hash SHA-256 do arquivo recebido e de cada mensagem citada, para qualquer um conferir depois que o material não mudou.' },
	{ icone: 'users', titulo: 'Quem é quem', texto: 'Participantes, apelidos e números agrupados. O mesmo sujeito aparece como três contatos diferentes — e isso aparece resolvido.' },
	{ icone: 'database', titulo: 'Dados extraídos', texto: 'CPF, CNPJ, valores, chaves PIX, telefones, e-mails e endereços citados na conversa, todos validados.' },
	{ icone: 'search-check', titulo: 'Análise de integridade', texto: 'Sinais de edição do arquivo: quebra de sequência, horário fora de ordem, inconsistência de formato entre linhas.' },
	{ icone: 'video', titulo: 'Meia hora com você', texto: 'Reunião de leitura do parecer, para você formular os quesitos e decidir o que usa e o que deixa de fora.' },
];
---

<section id="entrega" class="bg-ink px-6 py-16 text-[#F7F3EE] md:px-10 md:py-24">
	<p class="mb-6 font-mono text-[13px] tracking-[.14em] text-on-dark-2 uppercase">O entregável</p>
	<h2 class="mb-12 max-w-[760px] text-[34px] leading-[1.12] text-[#F7F3EE] md:text-[44px]">O que chega na sua mão em 48 horas</h2>
	<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
		{
			itens.map((i) => (
				<li class="rounded-[14px] border border-white/10 p-6 transition-colors hover:border-accent-light/50">
					<span class="mb-5 grid size-11 place-items-center rounded-[10px] border border-accent-light/30 bg-accent-light/10 text-accent-light">
						<Icon name={i.icone} size={22} />
					</span>
					<h3 class="mb-2.5 text-xl leading-snug text-accent-light">{i.titulo}</h3>
					<p class="text-base leading-[1.6] text-on-dark">{i.texto}</p>
				</li>
			))
		}
	</ul>
</section>
